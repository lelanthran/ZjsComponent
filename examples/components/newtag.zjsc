<!-- vim: set ts=3 sw=3 tw=120 -->

<input name=test-value placeholder='enter a value here' />

<!-- ensure that sending via reference to classname works -->
<button onclick="newTag.send(this, 'testMethod', 'someparam')">
   newTag.send(obj)
</button>


<!-- ensure that sending via reference to query selector works -->
<button onclick="newTag.send('#id-2', 'testMethod', 'someparam')">
   newTag.send(selector)
</button>


<!-- ensure that sending via reference to tagname works -->
<button onclick="ZjsComponent.sendTo('new-tag', this, 'testMethod', 'someparam')">
   ZjsComponent.sendTo()
</button>

<script>
   function onConnected(obj) {
      console.log (`connected ${obj.getAttribute('name')}`);
   }

   function testMethod(param1) {
      console.log (this.instanceCount);
      const inputValue = this.querySelector("[name='test-value']").value;
      console.log (`testMethod ${inputValue}`);
   }

   exports.onConnected = onConnected;
   exports.testMethod = testMethod;
</script>

